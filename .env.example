# EduRipple Environment Configuration Template
# Copy this to .env for local development
# Production: Set these variables in Google Cloud Console

# ============================================
# CRITICAL: Generate/Set These in Production
# ============================================

# Flask Configuration
FLASK_ENV=development
# Generate with: python3 -c 'import secrets; print(secrets.token_hex(32))'
FLASK_SECRET_KEY=your_generated_secret_key_here_change_in_production

# ============================================
# AI Service API Keys (REQUIRED)
# ============================================

# Google Gemini API (get from: https://makersuite.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_key_here

# OpenRouter API (get from: https://openrouter.ai/keys)
OPENROUTER_API_KEY=your_openrouter_key_here

# ElevenLabs Text-to-Speech (get from: https://elevenlabs.io/app/settings/api-keys)
ELEVENLABS_API_KEY=your_elevenlabs_key_here
ELEVENLABS_DEFAULT_VOICE=rachel

# OpenAI API (optional, get from: https://platform.openai.com/account/api-keys)
OPENAI_API_KEY=your_openai_key_here

# YouTube API (optional, for resource recommendations)
YOUTUBE_API_KEY=your_youtube_key_here

# ============================================
# CORS & Networking (IMPORTANT)
# ============================================

# Comma-separated list of allowed origins
# Development: http://localhost:5000
# Production: https://yourdomain.com,https://www.yourdomain.com
CORS_ORIGINS=http://localhost:5000

# ============================================
# Rate Limiting (Security)
# ============================================

# Storage backend for rate limiting
# Options: memory:// (default), redis://localhost:6379/0
RATELIMIT_STORAGE_URL=memory://

# ============================================
# Caching
# ============================================

CACHE_TYPE=simple
CACHE_DEFAULT_TIMEOUT=300

# ============================================
# Database Configuration
# ============================================

# SQLite (development default)
DATABASE_URL=sqlite:///curriculum.db
TEACHERS_DB=teachers.db

# PostgreSQL (production - uncomment and configure)
# DATABASE_URL=postgresql://user:password@cloud-sql-instance/eduripple

# ============================================
# Logging & Monitoring
# ============================================

LOG_LEVEL=INFO
LOG_FILE=logs/app.log
REQUEST_LOGGING_ENABLED=False

# ============================================
# Production Security Settings
# ============================================

# Only set these when FLASK_ENV=production
HSTS_ENABLED=False
SESSION_COOKIE_SECURE=False

# ============================================
# Storage (Optional)
# ============================================

RESOURCE_DIR=resources

# Google Cloud Storage (production)
# GCS_BUCKET_NAME=eduripple-resources

# ============================================
# Port & Performance
# ============================================

PORT=5000
WORKERS=4
REQUEST_TIMEOUT=120
MAX_CONTENT_LENGTH=52428800


# App URL (used in CORS, OpenRouter referer, etc.)
APP_URL=https://yourdomain.com

# CORS Origins (comma-separated, * for all in dev)
CORS_ORIGINS=*
# CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Rate Limit Storage (use Redis in production)
# RATELIMIT_STORAGE_URL=redis://localhost:6379/1

# Email Configuration (for alerts)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# Admin Configuration
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=
